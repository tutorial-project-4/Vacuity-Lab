--- !u!114 &567437418
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 567437414}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4cfaf987c88048758448b1e798c18c6b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  lines:
  - speaker: 
    text: "\uC9C0\uAC11\uC774\uB2E4. \uC548\uC5D0 \uCE74\uB4DC \uD0A4\uAC00 \uC788\uC744
      \uAC83\uC774\uB2E4."
    image: {fileID: 0}
    hideDialogueWhileImage: 0
    choices: []
  - speaker: "\uD3F4"
    text: "\uB4DC\uB514\uC5B4 \uCC3E\uC558\uB2E4."
    image: {fileID: 0}
    hideDialogueWhileImage: 0
    choices: []
  - speaker: 
    text: "\uC9C0\uAC11 \uC18D\uC5D0 \uB0AF\uC775\uC740 \uB0A8\uC790\uC640 \uC5EC\uC790\uC758
      \uC0AC\uC9C4\uC774 \uC788\uB2E4. \uB458\uC740 \uB0A8\uB9E4\uCC98\uB7FC \uBCF4\uC778\uB2E4."
    image: {fileID: 0}
    hideDialogueWhileImage: 0
    choices: []
  - speaker: 
    text: 
    image: {fileID: 3118022364913050589, guid: 787677f0038f8d345bf327cf3703b027, type: 3}
    hideDialogueWhileImage: 1
    choices: []
  - speaker: 
    text: "\uC5B4\uB518\uAC00 \uADF8\uB9AC\uC6B4 \uAE30\uBD84\uC774 \uB4E0\uB2E4."
    image: {fileID: 0}
    hideDialogueWhileImage: 0
    choices: []
  - speaker: "\uB3CC\uC5F0\uBCC0\uC774 \uC5F0\uAD6C\uC6D0"
    text: "\u314D...\u3157\u3139..."
    image: {fileID: 0}
    hideDialogueWhileImage: 0
    choices: []
  - speaker: 
    text: "\uAD34\uBB3C\uC774 \uBB34\uC5B8\uAC00\uB97C \uB354 \uB9D0\uD558\uB824\uACE0
      \uD588\uC9C0\uB9CC \uC5BC\uB9C8 \uAC00\uC9C0 \uBABB\uD574 \uC228\uC774 \uB04A\uC5B4\uC84C\uB2E4."
    image: {fileID: 0}
    hideDialogueWhileImage: 0
    choices: []
  - speaker: "\uD3F4"
    text: "\uC774 \uAE30\uBD84\uC740 \uB3C4\uB300\uCCB4 \uBB50\uC9C0? \uBB54\uAC00
      \uC911\uC694\uD55C \uAC83\uC744 \uB193\uCE58\uACE0 \uC788\uB294 \uAC83 \uAC19\uC544."
    image: {fileID: 0}
    hideDialogueWhileImage: 0
    choices: []
  - speaker: "\uD3F4"
    text: "\uD06D..! \uBA38\uB9AC\uAC00, \uBA38\uB9AC\uAC00 \uB108\uBB34 \uC544\uD30C!"
    image: {fileID: 0}
    hideDialogueWhileImage: 0
    choices: []
  - speaker: 
    text: 
    image: {fileID: -60743645155883428, guid: 17bba4baf3e31794cb08365acf1c4d03, type: 3}
    hideDialogueWhileImage: 1
    choices: []
  - speaker: 
    text: 
    image: {fileID: 525222842041487464, guid: d0d26e989c2f189478c186636224b178, type: 3}
    hideDialogueWhileImage: 1
    choices: []
  - speaker: "\uD3F4"
    text: "\uC5F0\uAD6C\uC6D0\uC758 \uC774\uB984\uC740 \uC81C\uC774\uCF65\uC774\uC5C8\uC5B4.
      \uC81C\uC774\uCF65. \uC81C\uC774\uCF65... \uB098\uB294 \uADF8\uC640 \uAF64
      \uCE5C\uBD84\uC774 \uC788\uB294 \uC0AC\uC774\uC600\uB358 \uAC70 \uAC19\uC740\uB370,
      \uC820\uC7A5 \uB3C4\uBB34\uC9C0 \uB69C\uB837\uD558\uAC8C \uAE30\uC5B5\uC774
      \uB098\uC9C0 \uC54A\uC544. \uC870\uAE08 \uB354 \uB2E8\uC11C\uAC00 \uC788\uC5C8\uB2E4\uBA74...!"
    image: {fileID: 0}
    hideDialogueWhileImage: 0
    choices: []
  - speaker: "\uD3F4"
    text: "\uD6C4, \uC6B0\uC120 \uB300\uB2C8\uC5D0\uAC8C \uB3CC\uC544\uAC00 \uBD10\uC57C\uACA0\uC5B4."
    image: {fileID: 0}
    hideDialogueWhileImage: 0
    choices: []
  progressState: {fileID: 0}
  segments: []
  promptLabel: F
  triggerOnce: 1
  actionsBeforeDialogue:
  - {fileID: 567437423}
  actionsOnInteract:
  - {fileID: 567437422}
  - {fileID: 567437421}
