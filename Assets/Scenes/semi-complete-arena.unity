--- !u!114 &1755997729
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1755997728}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4cfaf987c88048758448b1e798c18c6b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueInteractable
  lines:
  - speaker: 
    text: "\uC218\uC0C1\uD55C \uBAA8\uB2C8\uD130\uB2E4. \uC548\uC758 \uC0AC\uB78C\uC774
      \uACE0\uD1B5\uC2A4\uB7EC\uC6B4 \uC18C\uB9AC\uB97C \uB0B4\uACE0 \uC788\uB2E4.
      \uC7A0\uAE50, \uC800\uAC8C \uC0AC\uB78C\uC774 \uB9DE\uC744\uAE4C. \uC804\uB958\uAC00
      \uD750\uB974\uB294 \uCEA1\uC290 \uB108\uBA38\uC758 \uD749\uCE21\uD55C \uD615\uCCB4\uAC00
      \uBCF4\uC778\uB2E4."
    image: {fileID: 0}
    hideDialogueWhileImage: 0
    choices: []
  - speaker: "\uC218\uAC10\uC790"
    text: "\uC73C\uC73D\u2026.\uAD34\uB85C\uC6CC."
    image: {fileID: 0}
    hideDialogueWhileImage: 0
    choices: []
  - speaker: ???
    text: "\uB9D0\uC744 \uD558\uC796\uC544?"
    image: {fileID: 0}
    hideDialogueWhileImage: 0
    choices: []
  - speaker: "\uC218\uAC10\uC790"
    text: "\uC73C\uC73C\u2026 \uC5B4? \uD3F4?! \uB108, \uC0B4\uC544 \uC788\uC5C8\uC5B4?"
    image: {fileID: 0}
    hideDialogueWhileImage: 0
    choices: []
  - speaker: "\uC218\uAC10\uC790"
    text: "\uC815\uB9D0 \uB2E4\uD589\uC774\uC57C. \uB108\uB77C\uB3C4 \uC0B4\uC544\uC788\uC5B4\uC11C."
    image: {fileID: 0}
    hideDialogueWhileImage: 0
    choices: []
  - speaker: "\uD3F4"
    text: "\uB098\uB97C \uC54C\uACE0 \uC788\uC5B4? \uC5EC\uAE30\uAC00 \uC5B4\uB518\uC9C0,
      \uB0B4\uAC00 \uC65C \uC5EC\uAE30\uC5D0 \uC788\uB294\uC9C0 \uC544\uBB34\uAC83\uB3C4
      \uBAA8\uB974\uACA0\uC5B4."
    image: {fileID: 0}
    hideDialogueWhileImage: 0
    choices: []
  - speaker: "\uC218\uAC10\uC790"
    text: "\uC815\uB9D0 \uC544\uBB34\uAC83\uB3C4 \uAE30\uC5B5\uC774 \uC548 \uB098?"
    image: {fileID: 0}
    hideDialogueWhileImage: 0
    choices: []
  - speaker: "\uD3F4"
    text: "\uADF8\uB798"
    image: {fileID: 0}
    hideDialogueWhileImage: 0
    choices: []
  - speaker: "\uC218\uAC10\uC790"
    text: ....
    image: {fileID: 0}
    hideDialogueWhileImage: 0
    choices: []
  - speaker: "\uD3F4"
    text: "\uC774\uBD10?"
    image: {fileID: 0}
    hideDialogueWhileImage: 0
    choices: []
  - speaker: "\uC218\uAC10\uC790"
    text: "\uC544\uB2C8\uC57C, \uC624\uD788\uB824 \uC88B\uC744\uC9C0\uB3C4. \uADF8
      \uB054\uCC0D\uD55C \uAE30\uC5B5\uC740 \uC78A\uB294 \uD3B8\uC774 \uB098\uC73C\uB2C8\uAE4C."
    image: {fileID: 0}
    hideDialogueWhileImage: 0
    choices: []
  - speaker: "\uD3F4"
    text: "\uBB34\uC2A8 \uC774\uC57C\uAE30\uB97C \uD558\uB294 \uAC70\uC57C?"
    image: {fileID: 0}
    hideDialogueWhileImage: 0
    choices: []
  - speaker: "\uC218\uAC10\uC790"
    text: "\uC5B4\uB514\uC11C\uBD80\uD130 \uC124\uBA85\uC744 \uD574\uC57C\uD560\uC9C0...
      \uC6B0\uC120 \uB098\uB294 \uB300\uB2C8\uC57C. \uC5EC\uAE34 \uAD6D\uAC00\uC5D0\uC11C
      \uBE44\uBC00\uB9AC\uC5D0 \uC6B4\uC601\uD558\uB294 \uC0DD\uCCB4 \uBCD1\uAE30
      \uC5F0\uAD6C\uC18C\uACE0. \uC6B0\uB9B0 \uC774 \uBE4C\uC5B4\uBA39\uC744 \uC5F0\uAD6C\uC18C\uC5D0\uC11C
      \uAC15\uC81C\uB85C \uC778\uCCB4 \uC2E4\uD5D8\uC744 \uB2F9\uD574\uC654\uC5B4.
      \uAC19\uC774 \uD0C8\uCD9C\uD558\uAE30\uB85C \uD588\uB294\uB370, \uC911\uAC04\uC5D0
      \uC0AC\uACE0\uAC00 \uB098\uB294 \uBC14\uB78C\uC5D0\u2026"
    image: {fileID: 0}
    hideDialogueWhileImage: 0
    choices: []
  - speaker: "\uD3F4"
    text: "\uC0AC\uACE0\uB77C\uB2C8?"
    image: {fileID: 0}
    hideDialogueWhileImage: 0
    choices: []
  - speaker: "\uB300\uB2C8"
    text: "\uC5F0\uAD6C\uC18C\uCE58\uACE0 \uC9C0\uB098\uCE58\uAC8C \uC870\uC6A9\uD558\uC9C0
      \uC54A\uC544? \uC870\uAE08\uC529 \uAE30\uC5B5\uC774 \uB0A0 \uAC70\uC57C. \uD3F4,
      \uD558\uC9C0\uB9CC \uB2F9\uC7A5\uC740 \uADF8 \uAE30\uC5B5\uC774 \uB3CC\uC544\uC62C
      \uB54C\uAE4C\uC9C0 \uAE30\uB2E4\uB9B4 \uC2DC\uAC04\uC774 \uC5C6\uC5B4. \uC0AC\uACE0
      \uB54C\uBB38\uC5D0 \uC5F0\uAD6C\uC18C\uAC00 \uBA48\uCD98 \uC9C0\uAE08\uC774
      \uD0C8\uCD9C\uD560 \uC218 \uC788\uB294 \uC720\uC77C\uD55C \uAE30\uD68C\uC57C.
      \uC11C\uB458\uB7EC \uC6C0\uC9C1\uC5EC\uC57C \uD574!"
    image: {fileID: 0}
    hideDialogueWhileImage: 0
    choices: []
  - speaker: 
    text: "\uC774 \uB140\uC11D\uC758 \uC5BC\uAD74\uC774 \uC5B4\uB834\uD48B\uC774
      \uAE30\uC5B5\uC5D0 \uB0A8\uC544\uC788\uC5B4. \uAC70\uC9D3\uB9D0\uC744 \uD558\uB294
      \uAC83 \uAC19\uC9C0\uB294 \uC54A\uC544. \uC774\uACF3\uC774 \uC815\uB9D0 \uBD88\uBC95\uC801\uC778
      \uC5F0\uAD6C\uC18C\uB77C\uBA74 \uD0C8\uCD9C\uD558\uAE34 \uD574\uC57C \uD560
      \uAC70 \uAC19\uC740\uB370..."
    image: {fileID: 0}
    hideDialogueWhileImage: 0
    choices: []
  - speaker: "\uD3F4"
    text: "\uC88B\uC544. \uCD9C\uAD6C\uB294 \uC5B4\uB514 \uC788\uC9C0?"
    image: {fileID: 0}
    hideDialogueWhileImage: 0
    choices: []
  - speaker: "\uB300\uB2C8"
    text: "\uC624\uB978\uCABD \uB108\uBA38\uC5D0 \uD0C8\uCD9C\uAD6C\uAC00 \uC788\uC5B4.
      \uD558\uC9C0\uB9CC \uD2B9\uC218\uD55C \uC7A5\uCE58\uB85C \uB9C9\uD600 \uC788\uC5B4\uC11C
      \uBC18\uB4DC\uC2DC \uB0B4\uAC00 \uD568\uAED8 \uAC00\uC57C \uD574. \uADF8\uB7EC\uB2C8\uAE4C
      \uD3F4, \uBA3C\uC800 \uC774 \uCEA1\uC290\uBD80\uD130 \uC5F4\uC5B4\uC918."
    image: {fileID: 0}
    hideDialogueWhileImage: 0
    choices: []
  - speaker: 
    text: "\uD749\uC545\uD558\uAC8C \uBD80\uD480\uC5B4 \uC788\uB294 \uC2E0\uCCB4\uC640
      \uBAB8\uC5D0 \uBD99\uC740 \uC218\uB9CE\uC740 \uC81C\uC5B4\uAE30\uAE30, \uC774\uAC83\uB4E4\uB9CC
      \uBD10\uB3C4 \uBD84\uBA85\uD788 \uC704\uD5D8\uD55C \uB140\uC11D\uC774\uC57C.
      \uC544\uBB34\uB7F0 \uAE30\uC5B5 \uC5C6\uC774 \uC815\uB9D0 \uB300\uB2C8\uB97C
      \uD480\uC5B4\uC8FC\uB294 \uAC8C \uB9DE\uC744\uAE4C?"
    image: {fileID: 0}
    hideDialogueWhileImage: 0
    choices: []
  - speaker: "\uB300\uB2C8"
    text: "\uC774\uAC83 \uCC38. \uB108 \uC9C0\uAE08 \uC774\uB7F0 \uAD34\uBB3C\uC774
      \uD558\uB294 \uB9D0\uC744 \uBBFF\uC5B4\uB3C4 \uB420\uAE4C, \uBB50 \uADF8\uB7F0
      \uC0DD\uAC01\uC744 \uD558\uACE0 \uC788\uC9C0? \uB2F5\uB2F5\uD574 \uC8FD\uACA0\uAD70.
      \uB4E4\uC5B4\uBD10 \uD3F4, \uB098\uB3C4 \uC6D0\uD574\uC11C \uC774\uB7F0 \uBAA8\uC2B5\uC774
      \uB41C \uAC8C \uC544\uB2C8\uC57C. \uB2E4 \uC2E4\uD5D8 \uBD80\uC791\uC6A9\uC774\uB780
      \uB9D0\uC774\uC57C. \uC800\uAE30, \uC218\uC0C1\uD55C \uAE30\uC0C9\uC774 \uBCF4\uC774\uBA74
      \uB098\uB97C \uC8FD\uC5EC\uB3C4 \uC88B\uC544. \uD55C \uBC88\uB9CC \uB098\uB97C
      \uBBFF\uC5B4\uBD10. \uB458 \uB2E4 \uAC1C\uC8FD\uC74C\uC744 \uB2F9\uD560 \uC218\uB294
      \uC5C6\uC796\uC544!"
    image: {fileID: 0}
    hideDialogueWhileImage: 0
    choices: []
  - speaker: "\uD3F4"
    text: "\uC54C\uC558\uC5B4. \uC5B4\uB5BB\uAC8C \uCEA1\uC290\uC744 \uC5F4 \uC218
      \uC788\uB294\uB370?"
    image: {fileID: 0}
    hideDialogueWhileImage: 0
    choices: []
  - speaker: "\uB300\uB2C8"
    text: "\uC67C\uCABD\uC758 \uBCF5\uB3C4\uB97C \uCB49 \uB530\uB77C \uAC78\uC5B4\uAC00\uBA74
      \uBC29\uC774 \uD558\uB098 \uC788\uC744 \uAC70\uC57C. \uADF8\uACF3\uC5D0\uC11C
      \uC774 \uCEA1\uC290\uC758 \uC7A0\uAE08\uC744 \uD574\uC81C\uD560 \uC218 \uC788\uB294
      \uCE74\uB4DC \uD0A4\uB97C \uAC00\uC838\uC624\uBA74 \uB3FC."
    image: {fileID: 0}
    hideDialogueWhileImage: 0
    choices: []
  - speaker: "\uD3F4"
    text: "\uADF8\uAC8C \uB2E4\uC57C? \uC5B4\uB835\uC9C0 \uC54A\uC544 \uBCF4\uC774\uB294
      \uAC78."
    image: {fileID: 0}
    hideDialogueWhileImage: 0
    choices: []
  - speaker: "\uB300\uB2C8"
    text: "\uC7A0\uAE50! \uB05D\uAE4C\uC9C0 \uB4E4\uC5B4. \uBC29 \uC548\uC5D0\uB294
      \uC2E4\uD5D8\uC561\uC758 \uB204\uCD9C\uB85C \uB3CC\uC5F0\uBCC0\uC774\uAC00
      \uB41C \uC5F0\uAD6C\uC6D0\uC774 \uD0A4\uB97C \uC9C0\uD0A4\uACE0 \uC788\uC5B4.
      \uADF8 \uB140\uC11D\uC744 \uC4F0\uB7EC\uD2B8\uB824\uC57C\uB9CC \uCE74\uB4DC
      \uD0A4\uB97C \uC5BB\uC744 \uC218 \uC788\uC744 \uAC70\uC57C. \uBAA9\uC228\uC774,
      \uC704\uD5D8\uD560 \uC218\uB3C4 \uC788\uC5B4. \uD560 \uC218 \uC788\uACA0\uC5B4?"
    image: {fileID: 0}
    hideDialogueWhileImage: 0
    choices: []
  - speaker: "\uD3F4"
    text: "\uBC29\uBC95\uC774 \uADF8\uAC83\uBFD0\uC778 \uAC70\uC796\uC544. \uB2E4\uB140\uC62C\uAC8C."
    image: {fileID: 0}
    hideDialogueWhileImage: 0
    choices: []
  - speaker: "\uB300\uB2C8"
    text: "\uBB34\uC0AC\uD574\uC57C\uD574\u2026 \uD3F4. \uB108\uB9C8\uC800 \uC8FD\uC73C\uBA74
      \uB098\uB294\u2026."
    image: {fileID: 0}
    hideDialogueWhileImage: 0
    choices: []
  - speaker: "\uB098\uB808\uC774\uC158"
    text: "\uB3C4\uB300\uCCB4 \uBB34\uC2A8 \uC77C\uC774 \uC788\uC5C8\uB358 \uAC70\uC57C.
      \uAE30\uC5B5\uC774 \uB098\uC9C0 \uC54A\uC544 \uB2F5\uB2F5\uD558\uAD70. \uC6B0\uC120
      \uD0A4\uB97C \uAC00\uC9C0\uACE0 \uB3CC\uC544\uC624\uC790."
    image: {fileID: 0}
    hideDialogueWhileImage: 0
    choices: []
  - speaker: "\uB300\uB2C8"
    text: "\uD3F4, \uBB34\uC0AC\uD588\uAD6C\uB098! \uC815\uB9D0 \uC5C4\uCCAD\uB09C
      \uC9C4\uB3D9\uC774\uC5C8\uC5B4. \uD3F4? \uD45C\uC815\uC774 \uC65C \uADF8\uB798?
      \uB3CC\uC5F0\uBCC0\uC774\uB97C \uC7A1\uC740 \uAC70 \uB9DE\uC544? \uC124\uB9C8
      \uCE74\uB4DC\uD0A4\uB97C \uAD6C\uD558\uC9C0 \uBABB\uD55C \uAC74 \uC544\uB2C8\uC9C0?"
    image: {fileID: 0}
    hideDialogueWhileImage: 0
    choices: []
  - speaker: "\uD3F4"
    text: "\uCE74\uB4DC\uD0A4\uB294 \uCC3E\uC558\uC5B4. \uD558\uC9C0\uB9CC, \uADF8
      \uC0AC\uB78C \uADF8\uB0E5 \uB3CC\uC5F0\uBCC0\uC774 \uC5F0\uAD6C\uC6D0\uC774
      \uC544\uB2CC \uAC83 \uAC19\uC544. \uADF8\uB807\uAC8C \uC8FD\uC5EC\uBC84\uB9AC\uBA74
      \uC548 \uB418\uB294 \uAC70\uC600\uB294\uB370... \uB0B4\uAC00 \uBB58 \uD6C4\uD68C\uD558\uACE0
      \uC788\uB294\uC9C0\uB3C4 \uBAA8\uB974\uACA0\uC5B4. \uAE30\uBD84\uC774 \uC774\uC0C1\uD574."
    image: {fileID: 0}
    hideDialogueWhileImage: 0
    choices: []
  - speaker: "\uB300\uB2C8"
    text: "\uD558\uD558, \uD3F4! \uBB34\uC2A8 \uC18C\uB9AC\uB97C \uD558\uB294 \uAC70\uC57C?
      \uADF8 \uC790\uC2DD\uC740 \uC0AC\uB78C\uC774 \uC8FD\uC5B4\uB098\uAC00\uB294\uB370\uB3C4
      \uC2E4\uD5D8\uC744 \uC9C4\uD589\uD558\uB358 \uBBF8\uCE58\uAD11\uC774 \uACFC\uD559\uC790\uC600\uC5B4!
      \uB108\uB294 \uB140\uC11D\uC744 \uC99D\uC624\uD588\uB2E4\uACE0!"
    image: {fileID: 0}
    hideDialogueWhileImage: 0
    choices: []
  - speaker: "\uD3F4"
    text: "\uBAA8\uB974\uACA0\uC5B4... \uC815\uB9D0."
    image: {fileID: 0}
    hideDialogueWhileImage: 0
    choices: []
  - speaker: "\uB300\uB2C8"
    text: "\uB410\uC5B4. \uAE30\uC5B5\uC740 \uB098\uAC00\uC11C \uCC3E\uC790\uAD6C.
      \uC5B4\uC11C \uCE74\uB4DC\uD0A4\uB97C \uBAA8\uB2C8\uD130\uC5D0 \uC5F0\uACB0\uD574."
    image: {fileID: 0}
    hideDialogueWhileImage: 0
    choices: []
  - speaker: "\uB300\uB2C8"
    text: "\uB4DC\uB514\uC5B4..!"
    image: {fileID: 0}
    hideDialogueWhileImage: 0
    choices: []
  - speaker: "\uD3F4"
    text: ...
    image: {fileID: 0}
    hideDialogueWhileImage: 0
    choices: []
  - speaker: "\uB300\uB2C8"
    text: "\uBB58 \uADF8\uB807\uAC8C \uBD88\uC548\uD55C \uD45C\uC815\uC73C\uB85C
      \uBCF4\uB294\uAC70\uC57C! \uAD34\uBB3C\uCC98\uB7FC \uC0DD\uAE34 \uAC70\uC5D0\uB3C4
      \uC0AC\uC815\uC774 \uC788\uB2E4\uB2C8\uAE50? \uB2E4 \uC54C\uC796\uC544! \uC5B4\uC11C
      \uD0C8\uCD9C\uC774\uB098 \uD558\uC790\uAD6C."
    image: {fileID: 0}
    hideDialogueWhileImage: 0
    choices: []
  progressState: {fileID: 1654731299}
