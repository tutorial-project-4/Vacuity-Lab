--- !u!114 &910220003
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 910220000}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec9ffcc33f8c4ef9a5293dd052f0a4e9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  advanceKeys: 140000000100000002000000
  canvas: {fileID: 910221002}
  rootGroup: {fileID: 910222004}
  backgroundImage: {fileID: 910222003}
  slideImage: {fileID: 910223003}
  speakerText: {fileID: 910224003}
  bodyText: {fileID: 910225003}
  bgmSource: {fileID: 910220004}
  sfxSource: {fileID: 910220004}
  endingBgm: {fileID: 8300000, guid: d03f8a55e120b3641822181e0b580b2b, type: 3}
  fadeSfx: {fileID: 0}
  pageSfx: {fileID: 0}
  bgmVolume: 0.8
  titleSceneName: Title 1
  fadeInDuration: 1
  fadeOutDuration: 0.8
  charactersPerSecond: 35
  slideFadeDuration: 0.35
  waitForInputAfterEachLine: 1
  blackScreenLines:
  - speaker: "\uB300\uB2C8"
    text: "\uD0C8\uCD9C\uC774\uB2E4! \uD06C\uC73C\uC73D, \uBA87 \uB144 \uB9CC\uC758
      \uC0C1\uCF8C\uD55C \uBC14\uAE65\uACF5\uAE30\uB0D0!"
  - speaker: "\uD3F4"
    text: "\uC628\uD1B5 \uD480\uC774\uAD70."
  slides:
  - title: 
    image: {fileID: -6892905824070983796, guid: a030a2fa4516cb44bbd754d2978893ae, type: 3}
    text: "\uC6B0\uB9AC\uB294 \uBB34\uC791\uC815 \uD480\uC744 \uD5E4\uCE58\uACE0
      \uAC78\uC5C8\uB2E4. \uB3C4\uB85C\uAC00 \uB098\uC62C \uB54C\uAE4C\uC9C0.\n\uD55C\uCC38
      \uAC77\uACE0 \uB098\uC11C \uB9C8\uCE68\uB0B4 \uB3C4\uB85C\uB97C \uBC1C\uACAC\uD55C
      \uC6B0\uB9AC\uB294 \uAC04\uC2E0\uD788 \uD480\uB9CC \uAC00\uB4DD\uD55C \uC774
      \uC0B0\uC744 \uBC97\uC5B4\uB0AC\uB2E4."
  - title: 
    image: {fileID: 8302597948441498989, guid: 316f3cfb69b084741aee143dd9a3bc10, type: 3}
    text: "\uADFC\uCC98 \uBAA8\uD154\uC5D0 \uB3C4\uCC29\uD55C \uD6C4 \uB300\uB2C8\uB294
      \uC774\uACF3\uC5D0 \uC788\uC73C\uBA74 \uB204\uAD70\uAC00 \uB098\uB97C \uB370\uB9AC\uB7EC
      \uC62C \uAC83\uC774\uB77C \uC77C\uB7EC\uC8FC\uACE0 \uC0AC\uB77C\uC84C\uB2E4.
      \uC544\uBB34\uAC83\uB3C4 \uAE30\uC5B5\uB098\uC9C0 \uC54A\uC558\uC9C0\uB9CC
      \uC8FC\uC0AC\uB97C \uD55C \uB300 \uB9DE\uC73C\uB2C8 \uAE30\uBD84\uC774 \uAD1C\uCC2E\uC544\uC9C4\uB2E4.
      \uB2E4\uD589\uD788 \uADF8 \uCE5C\uC808\uD55C \uB0A8\uC790\uB294 \uB5A0\uB098\uBA74\uC11C
      \uB098\uC5D0\uAC8C \uC5EC\uB7EC \uAC1C\uC758 \uC8FC\uC0AC\uAE30\uB97C \uC8FC\uACE0
      \uAC14\uB2E4."
  - title: 
    image: {fileID: -8666476357725157653, guid: 169aadad6b0ebd34c810c4134a7929dc, type: 3}
    text: "\uC5BC\uB9C8\uB098 \uC2DC\uAC04\uC774 \uC9C0\uB0AC\uC744\uAE4C, \uAE30\uC5B5\uC744
      \uD68C\uBCF5\uD560 \uB54C\uB9C8\uB2E4 \uC8FC\uC0AC\uB97C \uB193\uC73C\uB2C8
      \uC2DC\uAC04\uC758 \uD750\uB984\uB3C4 \uC54C \uC218 \uC5C6\uC5B4\uC84C\uB2E4.
      \uAC16\uACE0 \uC788\uB358 \uC8FC\uC0AC\uAE30\uB294 \uBAA8\uB450 \uC0AC\uC6A9\uD588\uB2E4.
      \uC870\uAE08\uC529 \uAE30\uC5B5\uC774 \uB3CC\uC544\uC624\uB294 \uAC10\uAC01\uC774
      \uBD88\uCF8C\uD558\uB2E4. \uC624\uB798\uB41C \uBAA8\uD154 TV\uC5D0\uC11C \uB0B4
      \uC5BC\uAD74\uC758 \uC218\uBC30\uC9C0\uAC00 \uBC29\uC601\uB418\uACE0 \uC788\uB2E4.\n[
      Q \uC5F0\uAD6C\uC18C \uBD80\uC18C\uC7A5 \uD3F4 \uB9E5\uADF8\uB798\uC2A4 ]\n\uC5F0\uAD6C\uC6D0\uC778
      \uC544\uB0B4\uC640 \uC5F0\uAD6C\uC18C\uC7A5\uC744 \uC0B4\uD574\uD558\uACE0
      \uC5F0\uAD6C\uC18C\uB97C \uD3ED\uD30C, \uD604\uC7AC\uB294 \uB3C4\uC8FC \uC911...
      \uC544\uB098\uC6B4\uC11C\uAC00 \uC2EC\uAC01\uD55C \uBAA9\uC18C\uB9AC\uB85C
      \uB9D0\uD55C\uB2E4. \uB3C4\uB300\uCCB4 \uC601\uBB38\uC744 \uBAA8\uB974\uACA0\uB294
      \uC18C\uB9AC \uBFD0\uC774\uB2E4. \uAE30\uC5B5\uC774 \uC870\uAE08\uC529 \uB3CC\uC544\uC624\uACE0
      \uC788\uB2E4. \uC544\uC8FC \uBD88\uCF8C\uD558\uACE0 \uC5ED\uACA8\uC6B4 \uAE30\uBD84\uC774\uB2E4.
      \uC8FC\uC0AC\uAE30, \uC8FC\uC0AC\uAE30\uAC00 \uD544\uC694\uD558\uB2E4.\n[end1
      \uC8FC\uC0AC\uAE30\uAC00 \uD544\uC694\uD574]"
