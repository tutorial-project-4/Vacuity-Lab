--- !u!114 &910200003
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 910200000}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14e0b4c9d2d84c87b01f0cf240d8d2ac, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueRunner: {fileID: 1163888852}
  lines:
  - speaker: "\uD3F4"
    text: "\uB9C9\uD600\uC788\uB124. "
    image: {fileID: 0}
    hideDialogueWhileImage: 0
    choices: []
  - speaker: "\uB300\uB2C8"
    text: "\uC774\uAC8C \uB0B4\uAC00 \uB9D0\uD55C \uD2B9\uC218\uD55C \uC7A5\uCE58\uC57C.
      \uC7A0\uAE50\uB9CC \uAE30\uB2E4\uB824 \uBD10, \uD574\uC81C\uD560 \uC218 \uC788\uB294
      \uBC29\uBC95\uC774 \uC788\uC73C\uB2C8\uAE4C.   "
    image: {fileID: 0}
    hideDialogueWhileImage: 0
    choices: []
  - speaker: "\uD3F4"
    text: "\uAE09\uD558\uB2E4\uBA70 \uB098\uC5D0\uAC8C \uB9E1\uACA8. \uC9C0\uAE08\uC758
      \uB098\uB77C\uBA74 \uC774\uAC78 \uB6AB\uC5B4\uB0BC \uC218 \uC788\uC744 \uAC70\uC57C. "
    image: {fileID: 0}
    hideDialogueWhileImage: 0
    choices: []
  triggerOnce: 1
--- !u!114 &910210000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1435210692}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14e0b4c9d2d84c87b01f0cf240d8d2ac, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueRunner: {fileID: 1163888852}
  lines:
  - speaker: 
    text: "\uC8FC\uC0AC\uAE30\uB97C \uC5B4\uB5BB\uAC8C \uD560\uAE4C?"
    image: {fileID: 0}
    hideDialogueWhileImage: 0
    choices:
    - text: "\uC8FC\uC0AC\uAE30\uB97C \uB9DE\uB294\uB2E4"
      nextLines:
      - speaker: "\uD3F4"
        text: "\uC54C\uC558\uC5B4."
        image: {fileID: 0}
        hideDialogueWhileImage: 0
        choices: []
      - speaker: 
        text: "\uB9C8\uC74C\uC774 \uD3B8\uC548\uD574\uC9C4\uB2E4. \uC870\uAE08 \uB098\uB978\uD55C
          \uAC83 \uAC19\uAE30\uB3C4 \uD558\uB2E4. \uBAB8 \uC0C1\uD0DC\uAC00 \uD68C\uBCF5\uB418\uC5C8\uB2E4."
        image: {fileID: 0}
        hideDialogueWhileImage: 0
        choices: []
      - speaker: "\uB300\uB2C8"
        text: "\uC774\uC81C \uB098\uAC08\uAE4C?"
        image: {fileID: 0}
        hideDialogueWhileImage: 0
        choices: []
      - speaker: "\uD3F4"
        text: "\uADF8\uB798."
        image: {fileID: 0}
        hideDialogueWhileImage: 0
        choices: []
      actionsOnChoose:
      - {fileID: 910210001}
      - {fileID: 910210005}
      - {fileID: 910210008}
      actionsOnComplete: []
    - text: "\uB9DE\uC9C0 \uC54A\uB294\uB2E4"
      nextLines:
      - speaker: "\uD3F4"
        text: "\uC544\uB2C8. \uC774 \uC8FC\uC0AC\uB294 \uD544\uC694 \uC5C6\uC5B4."
        image: {fileID: 0}
        hideDialogueWhileImage: 0
        choices: []
      - speaker: "\uB300\uB2C8"
        text: "\uBB34\uC2A8 \uC18C\uB9AC\uC57C? \uBA38\uB9AC\uAC00 \uC544\uD30C\uC11C
          \uC228\uB3C4 \uBABB \uC26C\uACE0 \uC788\uC73C\uBA74\uC11C!"
        image: {fileID: 0}
        hideDialogueWhileImage: 0
        choices: []
      - speaker: "\uD3F4"
        text: "\uAD1C\uCC2E\uC544\uC84C\uC5B4. \uB450\uD1B5\uC774 \uC870\uAE08 \uAC00\uC2DC\uB2C8\uAE4C
          \uBA87 \uAC00\uC9C0 \uB5A0\uC624\uB974\uB294 \uAE30\uC5B5\uC774 \uC788\uC5B4."
        image: {fileID: 0}
        hideDialogueWhileImage: 0
        choices: []
      - speaker: "\uB300\uB2C8"
        text: "\uADF8\uB798? \uBB50\uAC00 \uB5A0\uC624\uB974\uB294\uB370?"
        image: {fileID: 0}
        hideDialogueWhileImage: 0
        choices: []
      - speaker: "\uD3F4"
        text: ...
        image: {fileID: 0}
        hideDialogueWhileImage: 0
        choices: []
      - speaker: "\uB300\uB2C8"
        text: "\uBB58 \uAE30\uC5B5\uD558\uAE38\uB798 \uB208\uBB3C\uC744 \uD758\uB9AC\uB294
          \uAC70\uC57C. \uC751?"
        image: {fileID: 0}
        hideDialogueWhileImage: 0
        choices: []
      - speaker: "\uD3F4"
        text: ...
        image: {fileID: 0}
        hideDialogueWhileImage: 0
        choices: []
      - speaker: "\uB300\uB2C8"
        text: "\uAE30\uBD84 \uB098\uC05C \uD45C\uC815\uB9CC \uC9D3\uC9C0 \uB9D0\uACE0,
          \uB300\uB2F5\uD574!"
        image: {fileID: 0}
        hideDialogueWhileImage: 0
        choices: []
      - speaker: "\uD3F4"
        text: "\uC5F0\uAD6C\uC18C\uC5D0 \uC0AC\uACE0\uAC00 \uB0AC\uC5C8\uC9C0. \uD55C
          \uC5F0\uAD6C\uC6D0\uC774 \uC2E4\uD5D8\uCCB4\uB97C \uB3D9\uC815\uD558\uB294
          \uBC14\uB78C\uC5D0 \uC5B5\uC81C \uC7A5\uCE58\uAC00 \uB290\uC2A8\uD574\uC84C\uC5B4.
          \uB140\uC11D\uC740 \uD0C8\uCD9C\uD558\uAE30 \uC704\uD574 \uB09C\uB3D9\uC744
          \uBD80\uB9AC\uACE0 \uADF8 \uC5EC\uD30C\uB85C \uC5F0\uAD6C\uC6D0 \uB300\uBD80\uBD84\uC774
          \uC8FD\uC5C8\uB2E4. \uB450 \uBA85\uC744 \uC81C\uC678\uD558\uACE0, \uBE4C\uC5B4\uBA39\uC744
          \uB300\uB2C8, \uC81C\uC774\uCF65\uC740 \uB0B4 \uC120\uBC30 \uB3D9\uB8CC\uC600\uC5B4.
          \uADF8\uB9AC\uACE0, \uB098\uB294 \uC218\uAC10\uC790\uAC00 \uC544\uB2C8\uB77C
          \uC774 \uC5F0\uAD6C\uC18C\uC758 \uBD80\uC18C\uC7A5\uC774\uC57C."
        image: {fileID: 0}
        hideDialogueWhileImage: 0
        choices: []
      - speaker: "\uB300\uB2C8"
        text: "\uC774\uAC70 \uACE8\uCE58 \uC544\uD504\uAC8C \uB410\uB124. \uADF8\uB798\uC11C
          \uBB50, \uC5B4\uCA4C\uB77C\uAD6C? \uB488\uC9C4 \uC0AC\uB78C\uB4E4\uC740
          \uB3CC\uC544\uC624\uC9C0 \uC54A\uC544!"
        image: {fileID: 0}
        hideDialogueWhileImage: 0
        choices: []
      - speaker: "\uD3F4"
        text: "\uB0B4\uAC00 \uC0B4\uC544\uC788\uB294 \uD55C \uB108\uB294 \uC774\uACF3\uC5D0\uC11C
          \uD0C8\uCD9C\uD560 \uC218 \uC5C6\uC5B4. \uB108 \uAC19\uC740 \uB140\uC11D\uC744
          \uBC14\uAE65 \uC138\uC0C1\uC5D0 \uB0B4\uBCF4\uB0B4\uC120 \uC548 \uB3FC,
          \uBC16\uC5D0\uB294 \uC544\uB0B4\uAC00 \uC788\uC73C\uB2C8\uAE4C."
        image: {fileID: 0}
        hideDialogueWhileImage: 0
        choices: []
      - speaker: "\uB300\uB2C8"
        text: "\uD478\uD56B, \uADF8\uAC70 \uC815\uB9D0 \uC720\uAC10\uC774\uC57C."
        image: {fileID: 0}
        hideDialogueWhileImage: 0
        choices: []
      actionsOnChoose:
      - {fileID: 910210004}
      - {fileID: 910210006}
      actionsOnComplete:
      - {fileID: 910210003}
      - {fileID: 910210007}
  triggerOnce: 1
